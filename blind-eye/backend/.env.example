# BlindEye Backend — Environment Variables
# Copy this to .env and fill in your API keys.
# If keys are missing, the app falls back to demo dummy data.

SECRET_KEY=dev-secret

# AI Platform API Keys (optional — dummy data used if missing)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Database (optional — in-memory dummy data used if missing)
DATABASE_URL=
